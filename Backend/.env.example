# =============================================================================
#  Suman Backend — environment template
#  Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
DATABASE_URL="postgresql://suman:suman@localhost:5432/suman?schema=public"

# --- JWT ---------------------------------------------------------------------
# Generate fresh 64-char secrets:  openssl rand -hex 32
# The two MUST be different — reusing one lets a refresh token pass as an
# access token.
JWT_ACCESS_SECRET="replace-me-with-64-random-hex-chars-0000000000000000000000000000"
JWT_REFRESH_SECRET="replace-me-with-a-different-64-random-hex-string-11111111111111"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Cookies -----------------------------------------------------------------
# COOKIE_SECURE must be true in production (HTTPS only).
# Use SameSite=none + secure=true when the API and the storefront sit on
# different registrable domains; lax is correct for same-site deployments.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.suman.uz

# --- CORS --------------------------------------------------------------------
# Storefront and admin panel dev servers.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
PUBLIC_URL=http://localhost:4000

# --- OTP ---------------------------------------------------------------------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_DELIVERY_MODE=log

# --- Notifications -----------------------------------------------------------
# Set OTP_DELIVERY_MODE=real to send OTPs through Eskiz and SMTP.
ESKIZ_BASE_URL=https://notify.eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Commerce ----------------------------------------------------------------
# Minor units (tiyin). 25 000 so'm delivery, free over 500 000 so'm.
DELIVERY_FEE=2500000
FREE_DELIVERY_THRESHOLD=50000000
